# Server
PORT=3000
HOST=localhost

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/clips

# Base URL the workers use to reach the API
API_BASE_URL=http://localhost:3000

# YouTube Data API key (used by workers/fetchurl.js for discovery)
YT_API_KEY=

# OpusClip API key (used by workers/opusapi.js to submit clip jobs)
# Available on OpusClip Pro (Beta) / Business plans; found in the dashboard (lower-left).
OPUS_API_KEY=
